# Supabase (local values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Guarded demo sign-in at /demo?key=<DEMO_KEY> (optional, off when unset).
# DEMO_KEY must be 16+ random characters. DEMO_EMAIL must be a non-admin account ending @example.test.
# DEMO_PASSWORD is that account's password. Use only with throwaway test data.
DEMO_KEY=
DEMO_EMAIL=
DEMO_PASSWORD=

# Email (optional: without a key, emails are printed to the console)
RESEND_API_KEY=
EMAIL_FROM="Southbound <no-reply@yourdomain.com.au>"
