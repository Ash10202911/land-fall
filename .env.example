# Supabase (local values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (optional: without a key, emails are printed to the console)
RESEND_API_KEY=
EMAIL_FROM="Southbound <no-reply@yourdomain.com.au>"
